  provider_repr=Movie(id=ObjectId('68d3750d74555e08f3663aa8'), revision_id=None, douban_id='36490177', title='灼灼韶华', title_season='灼灼韶华', original_title_season='', original_title='', subtitle=None, pic='http://image.tmdb.org/t/p/w500/eSjqBiEQVWHY9FWp4gd7jK2mQKU.jpg', description='改编自晋江石头与水小说《野心家》。\n1916年，褚韶华为救哥哥褚韶中而嫁给陈记药铺的大少爷陈大顺，她以诚信和出色的商业才能得到陈父的赏识，成为药铺管理人。陈父和陈大顺意外去世后，陈二顺继承药铺并败光家财，药铺陷入绝境。褚韶华在艰辛努力下，开了华顺药铺养活一家老小。褚韶华决意携手初恋情人夏初开启新的生活，却遭陈二顺和陈母的阻挠。陈家被土匪洗劫一空，褚韶华也在这次劫难中失去女儿，伤心不已的她独自出走上海。褚韶华在上海永新百货业绩突出，受经营奇才闻知秋之邀共同创业，逐步成长为胆略过人、重诺守信的女商人。', year='2025', category=<MovieCategory.CHINA: 'China'>, movie_type=<MovieType.TV: 'TV'>, season='第一季', total_episodes='38集全', cloud_infos=[MovieCloudInfo(pancloud_name='4295quark', last_save_time=datetime.datetime(2025, 9, 26, 23, 45, 8, 290000, tzinfo=<DstTzInfo 'Asia/Shanghai' CST+8:00:00 STD>), last_save_link='https://pan.quark.cn/s/a04b144d15c7', last_save_success=True, pdir_name='灼灼韶华', latest_episode_number=34, share_link=None)], tmdb_infos=TMDBInfos(id=254488, season_number=1), episodes_info=[EpisodesInfo(episode_number=1, air_date=datetime.date(2025, 9, 11), air_time='19:30:00', full_air_datetime=datetime.datetime(2025, 9, 11, 19, 30, tzinfo=<DstTzInfo 'Asia/Shanghai' LMT+8:06:00 STD>), weekday='星期四'), EpisodesInfo(episode_number=2, air_date=datetime.date(2025, 9, 11), air_time='20:29:00', full_air_datetime=datetime.datetime(2025, 9, 11, 20, 29, tzinfo=<DstTzInfo 'Asia/Shanghai' LMT+8:06:00 STD>), weekday='星期四'), EpisodesInfo(episode_number=3, air_date=datetime.date(2025, 9, 11), air_time='19:30:00', full_air_datetime=datetime.datetime(2025, 9, 11, 19, 30, tzinfo=<DstTzInfo 'Asia/Shanghai' LMT+8:06:00 STD>), weekday='星期四'), EpisodesInfo(episode_number=4, air_date=datetime.date(2025, 9, 11), air_time='20:29:00', full_air_datetime=datetime.datetime(2025, 9, 11, 20, 29, tzinfo=<DstTzInfo 'Asia/Shanghai' LMT+8:06:00 STD>), weekday='星期四'), EpisodesInfo(episode_number=5, air_date=datetime.date(2025, 9, 12), air_time='19:30:00', full_air_dat